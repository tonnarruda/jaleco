# API da I Love Jalecos. Contexto do build: a pasta backend/.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /server ./cmd/server

# Imagem final sem shell nem gerenciador de pacotes: só o binário.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /server /server
USER nonroot
ENTRYPOINT ["/server"]
